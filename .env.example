# ── Dashboard API ──────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — the API refuses to start without this (no insecure fallback).
JWT_SECRET_KEY=change-me-in-production

# Fernet encryption key for stored database connection credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED for connection profile storage.
AEGIS_ENCRYPTION_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL of the Dashboard API as seen from the user's browser.
# Local dev default: http://localhost:8000
# Production example: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of origins the API allows for CORS requests.
# Must match the URL users visit in their browser (the frontend origin).
# Local dev default: http://localhost:3000
# Production example: https://dashboard.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── API Key (Engine + Airflow workers) ────────────────────────────────────────
# API key for the test engine to post results to the dashboard.
# Run 'make seed' to generate one (or create it in Settings on the dashboard).
# This is the value Airflow workers set as AEGIS_API_KEY.
AEGIS_API_KEY=

# ── Database Credentials ───────────────────────────────────────────────────────
# These are referenced in backend/config/database_connection.yaml using ${VAR}.
# Add the credentials for each connection profile you use:

# Staging (PostgreSQL example)
# STAGING_DB_HOST=staging.example.com
# STAGING_DB_USER=readonly_user
# STAGING_DB_PASSWORD=

# Production MySQL example
# MYSQL_HOST=prod.example.com
# MYSQL_DATABASE=analytics
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=
