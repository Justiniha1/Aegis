# ── Dashboard API ──────────────────────────────────────────────────────────────
# Deployment environment. Set to "production" on your hosted (Railway) deploy to arm
# the startup guardrails below. Leave unset/"development" for local work.
COMET_ENV=development

# Secret key used to sign JWT login tokens (server-side only — clients never see it).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production (COMET_ENV=production) the API refuses to start unless this is a real,
# non-placeholder value, so login sessions survive redeploys and tokens can't be forged.
JWT_SECRET_KEY=change-me-in-production

# Admin token that gates client provisioning (POST /api/v1/clients). Required in
# production; the provision_client.py script sends it as the X-Admin-Token header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COMET_ADMIN_TOKEN=

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL of the Dashboard API as seen from the user's browser.
# Local dev default: http://localhost:8000
# Production example: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of origins the API allows for CORS requests.
# Must match the URL users visit in their browser (the frontend origin).
# Local dev default: http://localhost:3000
# Production example: https://dashboard.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── API Key (Engine + Airflow workers) ────────────────────────────────────────
# API key for the test engine to post results to the dashboard.
# Run 'make seed' to generate one (or create it in Settings on the dashboard).
# This is the value Airflow workers set as COMET_API_KEY.
COMET_API_KEY=

# API key used by the Docker engine service (DQF_API_KEY in docker-compose.yml).
# Must match COMET_API_KEY — both names refer to the same generated key.
DQF_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max requests per window for POST /api/v1/runs, enforced per API key.
# Default: 10 requests per 60 seconds. Increase for high-volume Airflow DAGs.
# RATE_LIMIT_RUNS=10
# RATE_LIMIT_WINDOW=60

# ── Database Credentials ───────────────────────────────────────────────────────
# These are referenced in backend/config/database_connection.yaml using ${VAR}.
# Add the credentials for each connection profile you use:

# Staging (PostgreSQL example)
# STAGING_DB_HOST=staging.example.com
# STAGING_DB_USER=readonly_user
# STAGING_DB_PASSWORD=

# Production MySQL example
# MYSQL_HOST=prod.example.com
# MYSQL_DATABASE=analytics
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=

# --- Airflow demo (see docs/airflow-demo-runbook.md) ---
# Set on the API service (profiles resolve server-side):
DEMO_DB_HOST=          # demo Postgres host (Railway)
DEMO_DB_NAME=          # demo Postgres database name
DEMO_DB_USER=          # demo Postgres user
DEMO_DB_PASSWORD=      # demo Postgres password
# Set on the Airflow service (the hosted API URL is baked into the SDK — only the key is set):
COMET_API_KEY=         # demo client API key
_AIRFLOW_WWW_USER_USERNAME=admin     # pinned Airflow admin login
_AIRFLOW_WWW_USER_PASSWORD=          # choose a stable password
