# ── Dashboard API ──────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Change this before deploying.
JWT_SECRET_KEY=change-me-in-production

# ── Test Engine ────────────────────────────────────────────────────────────────
# URL of the Dashboard API. Leave as-is for local Docker setup.
DQF_API_URL=http://localhost:8000

# API key for the engine to post results to the dashboard.
# Run 'make seed' to generate one, then paste it here.
DQF_API_KEY=

# ── Database Credentials ───────────────────────────────────────────────────────
# These are referenced in backend/config/database_connection.yaml using ${VAR}.
# Add the credentials for each profile you use:

# Staging (PostgreSQL example)
# STAGING_DB_HOST=staging.example.com
# STAGING_DB_USER=readonly_user
# STAGING_DB_PASSWORD=

# Production MySQL example
# MYSQL_HOST=prod.example.com
# MYSQL_DATABASE=analytics
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=
